{
  "id": "bingo",
  "version": "0.10.1",
  "platformApi": "0.20.0",
  "name": "Bingo",
  "license": "AGPL-3.0-or-later",
  "author": "The Mosaicast Authors",
  "homepage": "https://github.com/Mosaicast/mosaicast-plugin-bingo",
  "backend": {
    "basePath": "/api/plugins/bingo",
    "extensions": [
      "dev.mosaicast.plugin.bingo.BingoPlugin"
    ]
  },
  "frontend": {
    "entry": "bingo.es.js",
    "elements": [
      "bingo-episode",
      "bingo-episode-card",
      "bingo-page"
    ]
  },
  "slots": [
    {
      "scope": "episode",
      "element": "bingo-episode-card",
      "placement": "card",
      "visibleTo": "anonymous",
      "order": 100
    },
    {
      "scope": "episode",
      "element": "bingo-episode",
      "placement": "main",
      "visibleTo": "anonymous",
      "order": 100
    },
    {
      "scope": "site",
      "element": "bingo-page",
      "placement": "page",
      "visibleTo": "anonymous",
      "order": 100
    }
  ],
  "nav": [
    {
      "path": "",
      "label": "Bingo",
      "icon": "dice"
    }
  ],
  "storage": {
    "schemaReadableBy": "admin",
    "schema": {
      "entry": {
        "episode": "string:indexed",
        "author": "string:indexed",
        "position": "integer",
        "text": "text:fulltext",
        "canonical": "string:indexed",
        "hit": "boolean",
        "ranked": "boolean",
        "recordedAt": "timestamp:indexed"
      },
      "card_result": {
        "episode": "string:indexed",
        "author": "string:indexed",
        "fields": "integer",
        "lines": "integer",
        "cells": "integer",
        "ranked": "boolean",
        "recordedAt": "timestamp:indexed"
      }
    }
  },
  "data": {
    "readableBy": "anonymous",
    "writableBy": "podcaster",
    "readsAllUsers": true,
    "keyFloors": [
      { "keys": ["resolution", "import:*", "unclaim:*", "participants"], "readableBy": "podcaster" },
      { "keys": ["notified"], "readableBy": "admin" }
    ],
    "backendOwned": [
      "phase",
      "candidates",
      "leaderboard",
      "recap",
      "answers",
      "stats",
      "suggestions",
      "history",
      "imports",
      "notified",
      "participants",
      "showcased"
    ],
    "backendPrivate": ["draft:*"]
  },
  "actions": {
    "callableBy": "fan",
    "names": {
      "draft-create": { "callableBy": "podcaster" },
      "draft-setup": { "callableBy": "podcaster" },
      "draft-players": { "callableBy": "podcaster" },
      "draft-invite": { "callableBy": "podcaster" },
      "draft-start": { "callableBy": "podcaster" },
      "draft-cancel": { "callableBy": "podcaster" },
      "draft-end": { "callableBy": "podcaster" },
      "draft-join": {},
      "draft-decline": {},
      "draft-state": {},
      "draft-move": {},
      "draft-vote": {},
      "draft-inbox": {}
    }
  },
  "channels": {
    "subscribableBy": "fan"
  },
  "tags": {
    "readsVocabulary": true,
    "writesEpisodes": false
  },
  "identity": {
    "resolvesUsers": true
  },
  "notifications": {
    "sends": true,
    "perUserPerDay": 5
  },
  "config": {
    "ingestIntervalSeconds": {
      "type": "number",
      "default": 60,
      "editableBy": "podcaster",
      "min": 10,
      "max": 3600,
      "step": 1,
      "label": { "en": "Update interval (seconds)", "de": "Aktualisierungsintervall (Sekunden)" },
      "description": {
        "en": "How often cards are collected and scores recomputed, from 10 to 3600. Changes apply within one interval.",
        "de": "Wie oft Karten eingesammelt und Punkte neu berechnet werden, von 10 bis 3600. Änderungen greifen innerhalb eines Intervalls."
      }
    },
    "fuzzyThreshold": {
      "type": "number",
      "default": 0.82,
      "editableBy": "podcaster",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "label": { "en": "Match similarity", "de": "Ähnlichkeitsschwelle" },
      "description": {
        "en": "How alike two entries must be, from 0 to 1, to count as the same prediction. Higher merges less. Entries with different numbers are never merged.",
        "de": "Wie ähnlich sich zwei Einträge sein müssen, von 0 bis 1, um als dieselbe Vorhersage zu gelten. Höher führt weniger zusammen. Einträge mit unterschiedlichen Zahlen werden nie zusammengeführt."
      }
    },
    "defaultGridSize": {
      "type": "number",
      "default": 3,
      "editableBy": "podcaster",
      "label": { "en": "Default grid", "de": "Standard-Raster" },
      "description": {
        "en": "Used for a bingo whose template doesn't set a size.",
        "de": "Gilt für ein Bingo, dessen Vorlage keine Größe angibt."
      },
      "options": [
        { "value": 3, "label": "3x3" },
        { "value": 4, "label": "4x4" },
        { "value": 5, "label": "5x5" }
      ]
    },
    "allowLateEntries": {
      "type": "boolean",
      "default": true,
      "editableBy": "podcaster",
      "label": { "en": "Allow late cards", "de": "Späte Karten erlauben" },
      "description": {
        "en": "Someone who missed the lock may still hand in a card once. It is scored, but never ranked.",
        "de": "Wer die Sperre verpasst hat, kann trotzdem einmal eine Karte abgeben. Sie wird gewertet, aber nie in die Rangliste aufgenommen."
      }
    },
    "archiveAfterDays": {
      "type": "number",
      "default": 30,
      "editableBy": "podcaster",
      "min": 1,
      "max": 3650,
      "step": 1,
      "label": { "en": "Archive after (days)", "de": "Archivieren nach (Tagen)" },
      "description": {
        "en": "Days after resolving before a bingo closes for good and nothing more is recorded.",
        "de": "Tage nach dem Auflösen, bis ein Bingo endgültig schließt und nichts mehr aufgezeichnet wird."
      }
    },
    "minCardsPerCard": {
      "type": "number",
      "default": 3,
      "editableBy": "podcaster",
      "min": 1,
      "max": 100,
      "step": 1,
      "label": { "en": "Cards for the per-card ranking", "de": "Karten für die Wertung pro Karte" },
      "description": {
        "en": "How many cards someone needs to be ranked per card, so one lucky card can't lead for good. In a season with fewer bingos, they need all of them.",
        "de": "Wie viele Karten jemand für die Wertung pro Karte braucht, damit keine einzelne Glückskarte dauerhaft führt. In einer Staffel mit weniger Bingos braucht es alle."
      }
    },
    "minPredictionBingos": {
      "type": "number",
      "default": 3,
      "editableBy": "podcaster",
      "min": 2,
      "max": 100,
      "step": 1,
      "label": { "en": "Bingos before a prediction is rated", "de": "Bingos, bevor eine Vorhersage bewertet wird" },
      "description": {
        "en": "How many bingos a prediction must be on before it's rated reliable or unreliable. At least two people must have written it, too.",
        "de": "Auf wie vielen Bingos eine Vorhersage stehen muss, bevor sie als zuverlässig oder unzuverlässig gilt. Außerdem müssen sie mindestens zwei Personen geschrieben haben."
      }
    },
    "rankBy": {
      "type": "string",
      "default": "lines",
      "editableBy": "admin",
      "label": { "en": "Rank by", "de": "Rangfolge nach" },
      "description": {
        "en": "Which score orders the leaderboard. The other one breaks ties.",
        "de": "Welche Wertung die Rangliste ordnet. Die andere entscheidet bei Gleichstand."
      },
      "options": [
        { "value": "lines", "label": { "en": "Lines", "de": "Reihen" } },
        { "value": "fields", "label": { "en": "Fields", "de": "Felder" } }
      ]
    }
  }
}
